# Supabase Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_anon_key"

# Encryption Key for AES-256
VITE_ENCRYPTION_KEY="your_secret_encryption_key"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="https://malaf.site"

# Backend-only Supabase service role key (bypasses RLS) — used ONLY by the
# Moyasar webhook handler in server.ts to write subscription status.
# NEVER expose this to the frontend / prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# Moyasar (payment gateway) — get these from the Moyasar dashboard.
# Leave MOYASAR_SECRET_KEY unset to keep payments disabled
# (POST /api/payments/initiate returns 503 until it's set).
MOYASAR_SECRET_KEY=""
MOYASAR_WEBHOOK_SECRET=""

# Moyasar's PUBLISHABLE key (safe to expose client-side — it can only
# tokenize card details, never create/refund a payment). Used by the
# billing checkout form (src/views/Billing.tsx) to call Moyasar's
# tokenization API directly from the browser, so raw card data never
# touches our own server.
VITE_MOYASAR_PUBLISHABLE_KEY=""

# Allowed CORS origins, comma-separated. Required in production —
# server.ts refuses to default to localhost there.
ALLOWED_ORIGINS="https://malaf.site,https://www.malaf.site"

# Sentry error tracking (optional). Leave unset to disable.
SENTRY_DSN=""
VITE_SENTRY_DSN=""

# Resend (transactional email, optional). Leave unset to disable.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="notifications@malaf.site"
